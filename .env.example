# Copie para .env e preencha. O .env não vai para o git.

# Token do bot (Discord Developer Portal → sua aplicação → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# Opcional, para desenvolvimento: ID de um servidor onde os comandos são registrados só ali.
# Vazio = comandos globais (todos os servidores do bot). Veja o README.
DISCORD_DEV_GUILD_ID=

# Login do painel admin (http://localhost:8080) e do /actuator/prometheus
ADMIN_USER=admin
ADMIN_PASSWORD=

# Porta do painel no seu computador
ADMIN_PORT=8080

# Servidor de cipher do YouTube. Se não definir, usa o público https://cipher.kikkia.dev/api (sem garantia de uptime)
# YOUTUBE_CIPHER_URL=https://cipher.kikkia.dev/api
# YOUTUBE_CIPHER_PASSWORD=

# Login no YouTube: só é necessário se o YouTube bloquear também o client IOS ("This video requires login" ao tocar).
# USE UMA CONTA GOOGLE DESCARTÁVEL, nunca a sua principal (risco de bloqueio da conta).
# 1) Ligue com YOUTUBE_OAUTH_ENABLED=true e o refresh token vazio;
# 2) o log mostra um código: abra https://www.google.com/device, digite o código e entre com a conta descartável;
# 3) o log mostra o refresh token: copie para YOUTUBE_OAUTH_REFRESH_TOKEN e reinicie.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Onde ficam as playlists: memory (padrão, some ao reiniciar) ou mongo
STORAGE_TYPE=memory
# Só com STORAGE_TYPE=mongo. O nome do banco vem da URI.
# MONGODB_URI=mongodb://usuario:senha@localhost:27017/sabadaco

# Ids do Discord que veem e tocam a playlist de qualquer pessoa (separados por vírgula). Padrão: o gabriellpa.
# DISCORD_ADMIN_IDS=334670701011271682

# Streaming de tela (/stream). Crie um projeto em https://cloud.livekit.io e copie URL, API key e secret.
# Sem eles o /stream avisa que não está configurado; o resto do bot funciona normalmente.
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Endereço público do bot (o do Cloudflare Tunnel), usado nos links enviados por DM
# STREAM_PUBLIC_URL=https://sabadaco.seu-dominio.com
# Chat da stream: mostrar na página o que é escrito no canal de texto. Antes de ligar, ative
# "Message Content Intent" no Developer Portal (Bot → Privileged Gateway Intents), senão o bot não conecta.
# Para mandar com o nome e o avatar de quem escreveu na página, dê ao bot "Gerenciar webhooks" no canal.
# DISCORD_MESSAGE_CONTENT=true
# Stream pela Atividade do Discord (botão de Atividades no canal de voz), além do link pelo navegador.
# Developer Portal → Activities: ligue "Ativar atividades"; URL Mappings: "/" → stream.seu-dominio.com/stream/activity
# e "/livekit" → seu-projeto.livekit.cloud; OAuth2 → Redirects: https://127.0.0.1 (só preenchimento).
# O client secret fica em OAuth2 → Client Secret. Sem ele a Atividade mostra que não está configurada.
# DISCORD_CLIENT_SECRET=
# Vazio = id do próprio bot (é o mesmo Application ID na maioria dos apps)
# DISCORD_CLIENT_ID=
