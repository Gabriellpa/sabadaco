# Copie para .env e preencha. O .env não vai para o git.

# Token do bot (Discord Developer Portal → sua aplicação → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# Opcional, para desenvolvimento: ID de um servidor onde os comandos são registrados só ali.
# Vazio = comandos globais (todos os servidores do bot). Veja o README.
DISCORD_DEV_GUILD_ID=

# Login do painel admin (http://localhost:8080) e do /actuator/prometheus
ADMIN_USER=admin
ADMIN_PASSWORD=

# Porta do painel no seu computador
ADMIN_PORT=8080

# Servidor de cipher do YouTube. Se não definir, usa o público https://cipher.kikkia.dev/api (sem garantia de uptime)
# YOUTUBE_CIPHER_URL=https://cipher.kikkia.dev/api
# YOUTUBE_CIPHER_PASSWORD=

# Login no YouTube (necessário se aparecer "This video requires login" ao tocar).
# USE UMA CONTA GOOGLE DESCARTÁVEL, nunca a sua principal (risco de bloqueio da conta).
# 1) Ligue com YOUTUBE_OAUTH_ENABLED=true e o refresh token vazio;
# 2) o log mostra um código: abra https://www.google.com/device, digite o código e entre com a conta descartável;
# 3) o log mostra o refresh token: copie para YOUTUBE_OAUTH_REFRESH_TOKEN e reinicie.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
